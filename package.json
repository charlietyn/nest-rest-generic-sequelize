{
  "name": "@charlietyn/nest-rest-sequelize",
  "version": "1.0.0",
  "description": "Reusable NestJS 11/12 Model, Service and Controller classes for Sequelize REST APIs, filtering, relations, pagination, hierarchy, transactions and caching.",
  "author": "Charlietyn",
  "license": "MIT",
  "keywords": [
    "nestjs",
    "sequelize",
    "sequelize-typescript",
    "rest",
    "crud",
    "generic",
    "filtering",
    "pagination",
    "hierarchy",
    "cache"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:dependencies && npm run test:release",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:release": "node --test test/release.test.mjs",
    "test:dependencies": "node --test test/dependency-audit.test.mjs test/dependency-compatibility.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "check:package": "node scripts/check-package.mjs",
    "audit:runtime": "node scripts/audit-dependencies.mjs --runtime",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:package && npm run test:package && npm run audit:dependencies",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/publish-guard.mjs",
    "release": "node scripts/release.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@nestjs/sequelize": "^11.0.0 || ^12.0.0",
    "exceljs": "^3.4.0",
    "pdfkit": "^0.15.0 || ^0.16.0 || ^0.17.0 || ^0.18.0 || ^0.19.0 || ^0.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.0",
    "sequelize-typescript": "^2.1.6"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    },
    "pdfkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/sequelize": "^12.0.0",
    "@nestjs/testing": "^12.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/validator": "^13.11.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "eslint": "^10.13.0",
    "exceljs": "^3.4.0",
    "globals": "^16.0.0",
    "jest": "^30.5.2",
    "pdfkit": "^0.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "semver": "^7.7.0",
    "sequelize": "^6.35.0",
    "sequelize-typescript": "^2.1.6",
    "sqlite3": "^6.0.1",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "Node10",
            "types": [
              "node",
              "jest"
            ]
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/example/**"
    ],
    "testEnvironment": "node"
  },
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlietyn/nest-rest-generic-sequelize.git"
  },
  "homepage": "https://github.com/charlietyn/nest-rest-generic-sequelize#readme",
  "bugs": {
    "url": "https://github.com/charlietyn/nest-rest-generic-sequelize/issues"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
